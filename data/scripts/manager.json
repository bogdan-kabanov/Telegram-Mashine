    "bet_1": [
      { "role": "manager", "type": "bet", "content": "bet_1", "delayMinutes": 15 }
    ],
    "bet_2": [
      { "role": "manager", "type": "bet", "content": "bet_2", "delayMinutes": 25 }
    ],
    "bet_3": [
      { "role": "manager", "type": "bet", "content": "bet_3", "delayMinutes": 35 }
    ],
    "completion": [
