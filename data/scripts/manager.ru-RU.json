      { "role": "manager", "type": "text", "content": "Объясню, как работает наша схема инвестирования по шагам 📊", "delayMinutes": 16 },
      { "role": "manager", "type": "text", "content": "Сначала смотрим рынок, потом делаем сделки и в конце делим прибыль 💰", "delayMinutes": 18 },
