# Environment
NODE_ENV=development

# Telegram Bot
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_WEBHOOK_SECRET=your_webhook_secret_min_8_chars
TELEGRAM_ADMIN_IDS=123456789
TELEGRAM_PUBLISH_CHANNEL_ID=-1001234567890

# Application
PORT=3000
APP_URL=https://your-domain.com

# Database (SQLite, auto-created in DATA_DIR/app.db)
# DATABASE_PATH=./data/app.db

# OpenAI (экономная модель для генерации диалогов)
OPENAI_API_KEY=your_openai_key_here
OPENAI_MODEL=gpt-4o-mini
# Фото клиента: off | fallback (если пул пуст) | always (каждый отзыв)
AI_CLIENT_PHOTOS=fallback
# Модель картинок для фото/ставок/условий: gpt-image-1 (dall-e-3 часто недоступен на новых ключах)
OPENAI_IMAGE_MODEL=gpt-image-1
# Чеки банков по образцам: off | fallback | always
AI_RECEIPTS=fallback
# Модель для правок чеков (нужен images.edit): gpt-image-1
OPENAI_RECEIPT_IMAGE_MODEL=gpt-image-1
# Ставки / условия / стикеры / аватар: off | fallback | always (кружки MP4 — только загрузка)
AI_MEDIA=fallback
# Эти же модели/режимы и ключ можно задать в админке: /admin/ai → config/ai-settings.json
# (файл перекрывает значения из .env без перезапуска; не коммитьте его)

# Paths (optional, defaults shown)
DATA_DIR=./data
CONFIG_DIR=./config
# Stable Playwright browsers path (avoid Cursor temp sandbox cache).
# Windows example — use YOUR real username, or omit and scripts use %LOCALAPPDATA%\ms-playwright
# PLAYWRIGHT_BROWSERS_PATH=C:/Users/bogda/AppData/Local/ms-playwright
PLAYWRIGHT_BROWSERS_PATH=C:/Users/bogda/AppData/Local/ms-playwright

# --- Docker ---
# See .env.docker.example and: docker compose up -d --build
# AUTO_SETUP_WEBHOOK=1
