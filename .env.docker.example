# Copy to .env and fill in real values before: docker compose up -d
NODE_ENV=production

# Telegram
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_WEBHOOK_SECRET=change_me_min_8_chars
TELEGRAM_ADMIN_IDS=123456789,987654321
TELEGRAM_PUBLISH_CHANNEL_ID=-1001234567890

# Public URL of this deployment (must be HTTPS for Telegram webhook)
APP_URL=https://your-domain.com
PORT=3000

# OpenAI
OPENAI_API_KEY=your_openai_key_here
OPENAI_MODEL=gpt-4o-mini

# Paths inside container (usually leave as-is)
DATA_DIR=/app/data
CONFIG_DIR=/app/config

# Auto-register webhook on container start (1 = yes)
AUTO_SETUP_WEBHOOK=1
